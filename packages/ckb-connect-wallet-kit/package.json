{
  "name": "ckb-connect-wallet-kit",
  "version": "0.1.1",
  "description": "Compound React wallet connection UI for @ckb-ccc/connector-react (Nervos CKB).",
  "license": "MIT",
  "author": "Victor-Okenwa",
  "homepage": "https://ckb-connect-kit.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Victor-Okenwa/revamp-ckb-connect-wallet.git",
    "directory": "packages/ckb-connect-wallet-kit"
  },
  "bugs": {
    "url": "https://github.com/Victor-Okenwa/revamp-ckb-connect-wallet/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "keywords": [
    "ckb",
    "connect",
    "wallet",
    "kit",
    "react",
    "typescript",
    "nervos"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@ckb-ccc/connector-react": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
